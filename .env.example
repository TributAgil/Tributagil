# ─────────────────────────────────────────────────────────────
#  Supabase — expostas ao BROWSER (precisam do prefixo VITE_)
#  A chave `anon` é pública por natureza e deve ser protegida por RLS.
#  (O /api/gemini NÃO precisa de env própria de Supabase: a URL e a anon key
#   viajam no corpo da request e o isolamento vem do token do usuário + RLS.)
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────
#  Gemini — usada SOMENTE no backend (/api/gemini). SEM prefixo VITE_,
#  para que a chave nunca seja embutida no bundle do frontend.
#  Aceita tanto o formato antigo (AIzaSy...) quanto o novo (AQ....).
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AQ....
# Opcional — modelo. Padrão: gemini-2.5-flash-lite (barato, pinado).
#   gemini-flash-lite-latest  -> sempre o Flash-Lite mais novo
#   gemini-flash-latest       -> mais qualidade em documentos difíceis
# GEMINI_MODEL=gemini-2.5-flash-lite
# Opcional — orçamento de "thinking" (0 = desliga; padrão 512 = pouco).
# GEMINI_THINKING_BUDGET=512

# ─────────────────────────────────────────────────────────────
#  Envio de e-mail do formulário de suporte (/api/contato)
#  Sem RESEND_API_KEY, as mensagens são apenas registradas no log.
# ─────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
CONTATO_EMAIL_TO=contato@tributagil.online
CONTATO_EMAIL_FROM=TributÁgil <no-reply@tributagil.online>
